    <string name="card_unreadable">There is a code in this image, but Latch could not read a contact out of it.</string>
    <string name="card_title">Save as a contact</string>
    <string name="card_from_photo">Read from the photo. Check each field before saving — the card will not be here to check against afterwards.</string>
    <string name="card_field_notes">Notes</string>
    <string name="card_unplaced">The notes above are the lines Latch could not place. Edit or clear them before saving.</string>
    <string name="card_field_name">Name</string>
    <string name="card_field_organisation">Company</string>
    <string name="card_field_title">Job title</string>
    <string name="card_field_address">Address</string>
    <string name="card_field_phone">Phone</string>
    <string name="card_field_email">Email</string>
