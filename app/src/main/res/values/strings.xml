<?xml version="1.0" encoding="utf-8"?>
<!--
  NFR-402: every user-facing string lives here, so that NFR-403 (Hindi UI) is a translation
  job rather than a refactor. Nothing in :parser or :recipes produces display text for the
  same reason.
-->
<resources>
    <string name="app_name">Latch</string>

    <!-- FR-202: shown in the floating text-selection toolbar, six characters or fewer. -->
    <string name="capture_action_label">Latch</string>

    <string name="badge_event">EVENT</string>
    <string name="badge_task">TASK</string>

    <string name="capture_no_date">No date found</string>
    <string name="capture_undated_explanation">This will be saved without a date. Latch never guesses one.</string>
    <string name="capture_past_date">That date has already passed. Latch will offer a follow-up instead of a dated item.</string>
    <string name="capture_ambiguous_order">Read as %1$s. Change the date order in Settings.</string>
    <string name="capture_ambiguous_relative">Pick a day to finish this one.</string>
    <!-- FR-511: more than one date in a single capture, each with its own checkbox. -->
    <plurals name="capture_dates_found">
        <item quantity="one">%1$d date found in this capture</item>
        <item quantity="other">%1$d dates found in this capture</item>
    </plurals>
    <!-- FR-506 row 3, per row: this one cannot be saved, but its neighbours still can. -->
    <string name="capture_row_needs_date">No day for this time yet — this one cannot be saved.</string>
    <string name="capture_dismiss">Close</string>
    <string name="capture_save">Save</string>
    <string name="capture_saving">Saving…</string>
    <string name="capture_saved">Saved to %1$s</string>
    <!-- FR-803: the same message was captured before, so nothing was written this time. -->
    <string name="capture_already_saved">Already saved. Nothing was written again.</string>

    <!--
        FR-804. Both dates are shown because the user is being asked to move one thing to
        another, and cannot answer without seeing both. The weekday in each is computed from
        the date rather than taken from the captured text, which may contradict it.
    -->
    <string name="capture_reschedule_offer">This looks like a reschedule. \"%1$s\" is already saved for %2$s. Move it to %3$s?</string>
    <string name="capture_reschedule_update">Update</string>
    <string name="capture_reschedule_create_new">New</string>
    <string name="capture_reschedule_no_date">no date</string>
    <!-- The duplicate check gave up before reading every task; see the reading against FR-803. -->
    <string name="capture_saved_unchecked">Saved. Latch could not check every task for a duplicate, so this may be a second copy.</string>
    <!-- FR-807: the undo offer, carrying the seconds it has left so it visibly runs out. -->
    <string name="capture_undo">Undo (%1$d)</string>
    <string name="capture_undoing">Removing…</string>
    <string name="capture_undone">Removed. Nothing was left in your Google account.</string>
    <!-- NFR-303: an undo that failed says the item is still there, and where to go for it. -->
    <string name="capture_undo_failed">Could not remove this from Google. It is still there — remove it in Google Calendar or Google Tasks.</string>
    <string name="capture_undo_failed_partial">Removed %1$d of %2$d items. The rest are still in your Google account — remove them in Google Calendar or Google Tasks.</string>
    <!-- FR-806: no network, so the capture is on disk and goes to Google when there is one.
         Deliberately does not say "saved" — nothing is in the account yet. -->
    <string name="capture_queued">No connection. Saved on this phone and will go to %1$s when you are back online.</string>
    <!-- NFR-303: a failure says what happened and what was not saved. -->
    <string name="capture_save_error">Could not save to Google. Check your connection and try again — nothing was saved.</string>
    <string name="capture_save_no_destination">Finish setting up Latch before saving.</string>
    <string name="capture_save_needs_date">Latch found a time but no day, and cannot save without one yet.</string>
    <!-- FR-805: the link back to where a capture came from, written into the item itself. -->
    <string name="capture_source_link">Captured from %1$s</string>
    <!-- FR-512, interim: confidence is shown rather than blocking the save. -->
    <string name="capture_low_confidence">Latch is not confident about this one — check it before saving.</string>
    <!--
      FR-512, FR-506 rows 3 and 4, AC-03: the capture is going to the Capture Inbox rather than
      to Google. The button says so, because a Save button that quietly put something somewhere
      else would be the routing decision hidden from the person making it.
    -->
    <string name="capture_add_to_inbox">Add to Inbox</string>
    <string name="capture_sent_to_inbox">Added to your Inbox on this phone. Nothing was written to Google yet.</string>
    <string name="capture_route_undated">No date found, so this goes to your Inbox. Latch never guesses one — give it a date there.</string>
    <string name="capture_route_low_confidence">Latch is not confident about this one, so it goes to your Inbox to check first.</string>
    <string name="capture_route_incomplete">There is a time here but no day. This goes to your Inbox, where you can give it one.</string>
    <!-- FR-804 offline: the reschedule question needs a network to answer and a user to ask. -->
    <string name="capture_route_reschedule_offline">This looks like a change to something already saved, and Latch cannot check while offline. It goes to your Inbox so nothing is written twice.</string>
    <string name="capture_nothing_shared">Nothing was shared with Latch</string>
    <string name="capture_clipboard_empty">The clipboard is empty. Copy some text, then tap the tile.</string>

    <!--
      FR-215 and FR-207: on-device OCR. NFR-102 is why capture_extracting exists at all — the
      screen renders and fills in rather than waiting, so there has to be something to say
      while it waits.
    -->
    <string name="capture_extracting">Reading the text…</string>
    <!--
      FR-207 and NFR-102: a document is a wait with a number on it. The second number is how
      many pages will be read, not how many the document has — this is a progress line, and
      counting to fourteen while stopping at ten would show a bar that never fills. The cap
      itself is reported afterwards by capture_pdf_capped, which is where FR-207 puts it.
    -->
    <string name="capture_extracting_page">Reading page %1$d of %2$d…</string>
    <string name="capture_ocr_unreadable">Latch could not open that file. Try sharing it again, or share the text instead.</string>
    <string name="capture_ocr_no_text">No text found in that image.</string>
    <string name="capture_ocr_failed">Latch could not read that image. Nothing was sent anywhere — the reading happens on your phone.</string>
    <!--
      FR-207's cap, reported rather than applied silently. The requirement is explicit that a
      search which stopped looking must say so, because the user cannot otherwise tell it
      apart from there having been nothing on page eleven.
    -->
    <string name="capture_pdf_capped">First %1$d of %2$d pages read.</string>


    <!-- FR-806: the queue, visible to the user. -->
    <plurals name="home_queue_waiting">
        <item quantity="one">%1$d capture waiting to be saved to Google</item>
        <item quantity="other">%1$d captures waiting to be saved to Google</item>
    </plurals>
    <!--
      FR-806a: the queue is held because Google wants a sign-in, not because the network is
      down. It is the one stuck-queue state the user can actually clear, so it says what to do
      rather than what happened, and it sits beside the count rather than replacing it — the
      captures are still safe and still waiting, which is the reassuring half.
    -->
    <string name="home_queue_needs_sign_in">Sign in to Google again to save these. Tap Sign in below; nothing has been lost.</string>
    <string name="home_sign_in">Sign in</string>
    <!-- NFR-303: an entry that will not come right on its own says so rather than sitting
         in the count looking like it is still on its way. -->
    <plurals name="home_queue_given_up">
        <item quantity="one">%1$d could not be saved.</item>
        <item quantity="other">%1$d could not be saved.</item>
    </plurals>
    <!--
      FR-806: the manual retry the requirement's own note recorded as missing until Settings
      exists. It also revives an entry that had been given up on — the user has usually done
      something between the failure and the tap, and refusing to try is worse than trying.
    -->
    <string name="home_queue_retry">Retry now</string>

    <!--
      FR-704: an unobtrusive count of Inbox items, and nothing at all when there are none. The
      requirement's second half — "and shall not nag" — is why there is no badge, no
      notification and no colour on this.
    -->
    <plurals name="home_inbox_pending">
        <item quantity="one">%1$d capture waiting in your Inbox</item>
        <item quantity="other">%1$d captures waiting in your Inbox</item>
    </plurals>
    <string name="home_open_inbox">Open Inbox</string>

    <!--
      FR-807, where the capture window has gone. Same offer, same ten seconds, on the one
      surface left after a process death.
    -->
    <string name="home_undo_offer">Just saved. You can still undo it.</string>
    <string name="home_undo">Undo (%1$d)</string>

    <!-- ===== Capture Inbox, FR-701 to FR-705 ===== -->

    <string name="inbox_title">Inbox</string>
    <string name="inbox_empty">Nothing waiting. Captures Latch is unsure about will appear here.</string>
    <string name="inbox_back">Back</string>
    <!-- FR-702's five actions, in the requirement's own order. -->
    <string name="inbox_set_date">Set a date</string>
    <string name="inbox_edit_title">Title</string>
    <string name="inbox_save">Save to Google</string>
    <string name="inbox_snooze">Snooze a week</string>
    <string name="inbox_discard">Discard</string>
    <string name="inbox_snoozed_until">Snoozed until %1$s</string>
    <!-- FR-705: surfaced for review, never deleted automatically. -->
    <string name="inbox_aged">Waiting since %1$s. Still want it?</string>
    <string name="inbox_no_date_yet">No date yet</string>
    <string name="inbox_captured_on">Captured %1$s</string>
    <string name="inbox_date_picker_confirm">Use this date</string>
    <string name="inbox_date_picker_cancel">Cancel</string>
    <!-- FR-703: nothing here has reached the user's Google account. -->
    <string name="inbox_local_only">Everything here is on this phone only. Nothing reaches Google until you save it.</string>
    <string name="inbox_saving">Saving…</string>
    <string name="inbox_save_failed">Could not save that to Google. It is still here — try again.</string>

    <!-- ===== First-run setup, FR-101 to FR-110 ===== -->

    <string name="setup_step_counter">Step %1$d of %2$d</string>
    <string name="setup_back">Back</string>
    <string name="setup_next">Next</string>
    <string name="setup_finish">Finish</string>
    <string name="setup_retry">Try again</string>
    <!-- FR-109: every setup choice is editable afterwards, and the screens must say so. -->
    <string name="setup_changeable_later">You can change this later in Settings.</string>

    <!-- Step 1. FR-102 requires the privacy statement to be on the screen itself. -->
    <string name="setup_signin_title">Connect your Google account</string>
    <string name="setup_signin_blurb">Latch turns dates you find in any app into calendar events and tasks.</string>
    <string name="setup_signin_privacy_mail">Latch does not read your mail or your messages.</string>
    <string name="setup_signin_privacy_servers">Nothing you capture is stored on our servers. Parsing happens on this phone.</string>
    <string name="setup_signin_scopes_heading">Latch asks Google for permission to:</string>
    <string name="setup_signin_scope_events">create and update calendar events</string>
    <string name="setup_signin_scope_calendars">see your calendar list, and create the Latch calendar</string>
    <string name="setup_signin_scope_tasks">create tasks and see your task lists</string>
    <string name="setup_signin_scopes_footer">Nothing else. Not Gmail, not Drive, not Contacts.</string>
    <string name="setup_signin_action">Continue with Google</string>
    <string name="setup_signin_continue_as">Continue as %1$s</string>
    <string name="setup_signin_working">Signing in…</string>
    <string name="setup_signin_error">Could not sign in to Google.</string>
    <string name="setup_signin_cancelled">Sign-in was cancelled.</string>

    <!-- Step 2. FR-103 two options, Option B pre-selected; FR-104 the benefit in the user's terms. -->
    <string name="setup_destination_title">Where should captures go?</string>
    <string name="setup_destination_recommended">Recommended</string>
    <string name="setup_destination_latch_title">Create a Latch calendar</string>
    <string name="setup_destination_latch_benefit">Everything Latch saves lands in one calendar of its own. One colour, one tick box to show or hide it all in Google Calendar, and a whole batch can be undone at once.</string>
    <!-- FR-105 made visible: the calendar is created on Finish, not on reaching this screen. -->
    <string name="setup_destination_latch_when">The calendar is created when you finish setup. Leave now and nothing is added to your Google account.</string>
    <!-- Another Latch client may have created it already (SRS §4.1). -->
    <string name="setup_destination_latch_exists">You already have a Latch calendar. Latch will use it rather than making another.</string>
    <string name="setup_destination_existing_title">Use my existing calendars</string>
    <string name="setup_destination_existing_benefit">Captures go to a calendar you already have. You can add rules later to send different sources to different calendars.</string>
    <string name="setup_destination_pick">Pick the calendar to start with</string>
    <string name="setup_destination_loading">Loading your calendars…</string>
    <string name="setup_destination_error">Could not load your calendars.</string>
    <!-- FR-903: writing to an unticked calendar is indistinguishable from a failed write. -->
    <string name="setup_destination_hidden_badge">Hidden</string>
    <string name="setup_destination_hidden_warning">This calendar is unticked in Google Calendar, so anything saved to it will be invisible until you tick it.</string>
    <string name="setup_destination_hidden_offer">Turn it on when I finish setup</string>

    <!-- Step 3. FR-106 the list, FR-107 the disclosure. -->
    <string name="setup_tasks_title">Which task list?</string>
    <string name="setup_tasks_blurb">Deadlines without a time of day are saved as tasks.</string>
    <string name="setup_tasks_loading">Loading your task lists…</string>
    <string name="setup_tasks_error">Could not load your task lists.</string>
    <string name="setup_tasks_disclosure">Google shows every task list inside a single Tasks layer in Google Calendar. Unlike calendars, task lists cannot be given their own colour or hidden one at a time.</string>

    <!-- Commit. NFR-303: a failure says what happened and what to do about it. -->
    <string name="setup_commit_working">Finishing setup…</string>
    <string name="setup_commit_error_calendar">Could not create the Latch calendar. Check your connection and try again — nothing has been saved.</string>
    <string name="setup_commit_error_save">Could not save your settings on this phone. Try again.</string>

    <!-- The calendar as it appears in the user's Google Calendar (NFR-402). -->
    <string name="latch_calendar_summary">Latch</string>
    <string name="latch_calendar_description">Created by Latch. Dates and deadlines captured on your devices are saved here.</string>

    <string name="home_headline">Latch</string>
    <!--
      Says what the app can do, and is therefore a claim that goes stale as things are built.
      It has been wrong once: it told users undo was not built for the four days after FR-807
      landed, on the same screen that was correctly reporting a write queue. Anything asserting
      what is or is not built belongs under review whenever a slice lands.
    -->
    <string name="home_setup_pending">Setup is done. Captures are parsed, shown and saved to Google, every save can be undone for ten seconds, and anything Latch is unsure about waits in your Inbox instead of guessing.</string>
    <string name="home_try_it">Select text in any app and choose Latch from the toolbar, or share text, a screenshot or a PDF to Latch.</string>
</resources>
