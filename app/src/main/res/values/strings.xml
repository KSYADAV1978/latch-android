    <string name="notification_access_no_source_text">An item saved this way carries its date and a title, and not the message. The text of the notification is not copied into your calendar or your to-do list.</string>
    <string name="notification_access_no_webhook">If you have set up your own endpoint under Send captures to my own endpoint, nothing captured this way is ever sent to it.</string>
    <string name="notification_access_system_grant">Android grants this per app, not per notification, so Latch is technically able to see notifications from apps you have not chosen. It ignores them, and you can see and change the list below at any time.</string>
