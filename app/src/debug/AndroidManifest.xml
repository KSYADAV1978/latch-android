<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      DEBUG BUILDS ONLY. This whole file is the `debug` source set's manifest, so nothing
      below is merged into a release build — the receiver does not exist there rather than
      existing and being switched off. That distinction is the reason it is here and not
      behind a BuildConfig.DEBUG branch in the main manifest: a component guarded by a
      constant is still declared, and an exported receiver that issues a Google query on
      request is not something a release build should advertise.

      DebugDedugProbeReceiver is the instrument for the open FR-806 defect recorded in
      CLAUDE.md: a queued event-only capture drained and wrote a duplicate although an event
      with the same latch.source_hash was already in the calendar. Everything reachable from a
      JVM test is exonerated, so this runs the same query in the two contexts that differ —
      the app process and a WorkManager worker — and logs the URL, the status and the item
      count from each.

      exported=true because adb has to reach it; it takes only a hash, performs a read, and
      writes nothing.
    -->
    <application>

        <receiver
            android:name="com.latch.android.debug.DebugDedupProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.latch.android.debug.PROBE_DEDUP" />
            </intent-filter>
        </receiver>

        <!--
          FR-806a's device confirmation. Drops the cached access token so the next capture
          must re-authorize, which is the condition AC-10 has never been run under: its 28 Aug
          pass was inside a session whose token was still warm. Reproducing it honestly would
          mean waiting an hour for expiry.
        -->
        <receiver
            android:name="com.latch.android.debug.DebugInvalidateTokenReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.latch.android.debug.INVALIDATE_TOKEN" />
            </intent-filter>
        </receiver>

        <!--
          FR-1240(a). Google documents no limit on clientData entry count, key length or value
          length — not in the Person reference, not in the API overview, not anywhere a search
          reaches — and FR-1207's §7.2 analogue cannot be designed without those numbers. So the
          limits are measured rather than read.

          It writes to the user's contacts, which nothing else in this project does yet. Each
          trial creates one contact, reads it back, and deletes it before the next begins; every
          contact carries a distinctive marker name and a sweep removes any straggler from a run
          that died half way. It matches on that marker and on nothing else — a looser rule would
          make this a debug build capable of deleting a user's own contacts.

          What it is looking for is silent truncation rather than an error. An API that refuses
          an over-large payload is safe. One that accepts 200 entries and stores 50 is not,
          because §7.2's metadata would go missing from items already in an account and FR-1208
          would miss them for ever with nothing to report.
        -->
        <receiver
            android:name="com.latch.android.debug.DebugClientDataProbeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.latch.android.debug.PROBE_CLIENT_DATA" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
